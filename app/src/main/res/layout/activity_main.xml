<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iris Species Classifier"
            android:textAppearance="?attr/textAppearanceHeadline5"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Card for Inputs -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feature Inputs"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Sepal Length -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sepal Length"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvSepalLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.1 cm"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSepalLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="4.0"
                    android:valueTo="8.0"
                    android:value="5.1"
                    android:stepSize="0.1"
                    android:layout_marginBottom="8dp" />

                <!-- Sepal Width -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sepal Width"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvSepalWidthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.5 cm"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSepalWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="2.0"
                    android:valueTo="4.5"
                    android:value="3.5"
                    android:stepSize="0.1"
                    android:layout_marginBottom="8dp" />

                <!-- Petal Length -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Petal Length"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvPetalLengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.4 cm"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPetalLength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="1.0"
                    android:valueTo="7.0"
                    android:value="1.4"
                    android:stepSize="0.1"
                    android:layout_marginBottom="8dp" />

                <!-- Petal Width -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Petal Width"
                        android:textAppearance="?attr/textAppearanceBody1" />

                    <TextView
                        android:id="@+id/tvPetalWidthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.2 cm"
                        android:textAppearance="?attr/textAppearanceBody1"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPetalWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.1"
                    android:valueTo="2.5"
                    android:value="0.2"
                    android:stepSize="0.1" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPredict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Classify Species"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Card for Output -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prediction Result"
                    android:textAppearance="?attr/textAppearanceSubtitle1"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPredictedClass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Predicted: -"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <!-- Setosa Progress -->
                <TextView
                    android:id="@+id/tvSetosaProb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Setosa: 0.0%"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressSetosa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:trackCornerRadius="4dp" />

                <!-- Versicolor Progress -->
                <TextView
                    android:id="@+id/tvVersicolorProb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Versicolor: 0.0%"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVersicolor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:trackCornerRadius="4dp" />

                <!-- Virginica Progress -->
                <TextView
                    android:id="@+id/tvVirginicaProb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Virginica: 0.0%"
                    android:textAppearance="?attr/textAppearanceBody2" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressVirginica"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:trackCornerRadius="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>